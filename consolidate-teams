#!/usr/bin/env bash

log() { echo ">>> $@"; }
die() { echo "$@" >&2; exit 1; }

org=platform-mesh

keep=(
    contributors
    go-approvers
    go-maintainers
    node-maintainers
    release-managers
    tsc
    security
)

kept() {
    local slug
    for slug in "${keep[@]}"; do
        [[ $slug == "$1" ]] && return 0
    done
    return 1
}

obsolete_teams() {
    local slug
    for slug in $(gh api "orgs/$org/teams" --paginate -q '.[].slug'); do
        kept "$slug" || echo "$slug"
    done
}

members() {
    gh api "orgs/$org/teams/$1/members" --paginate -q '.[].login'
}

_plan() {
    for team in $(obsolete_teams); do
        log "delete $team"
        for user in $(members "$team"); do
            echo "    move $user to contributors"
        done
    done
}

_assign_to_contributors() {
    for team in $(obsolete_teams); do
        log "$team"
        for user in $(members "$team"); do
            if ! gh api -X PUT "orgs/$org/teams/contributors/memberships/$user" > /dev/null ; then
                log "adding $user to contributors failed - not deleting $team"
            fi
            echo "    $user added to contributors"
        done
    done
}

_remove_from_obsolete() {
    local contributors
    contributors=" $(members contributors | tr '\n' ' ') "
    for team in $(obsolete_teams); do
        log "$team"
        for user in $(members "$team"); do
            [[ $contributors == *" $user "* ]] || { echo "    keeping $user (not in contributors)"; continue; }
            gh api -X DELETE "orgs/$org/teams/$team/memberships/$user" > /dev/null \
                && echo "    removed $user" \
                || log "removing $user from $team failed"
        done
    done
}

_delete_teams() {
    for team in $(obsolete_teams); do
        log "$team"
        gh api -X DELETE "orgs/$org/teams/$team" || log "deleting $team failed"
    done
}

_delete_empty_teams() {
    for team in $(obsolete_teams); do
        if [[ -n $(members "$team") ]]; then
            log "keeping $team (has members)"
            continue
        fi
        log "deleting $team"
        gh api -X DELETE "orgs/$org/teams/$team" || log "deleting $team failed"
    done
}

subcmd="$1"
shift

case "$subcmd" in
    (plan) _plan;;
    (assign-to-contributors) _assign_to_contributors;;
    (remove-from-obsolete) _remove_from_obsolete;;
    (delete-teams) _delete_teams ;;
    (delete-empty-teams) _delete_empty_teams;;
    (*) die "Unknown subcommand: $subcmd";;
esac

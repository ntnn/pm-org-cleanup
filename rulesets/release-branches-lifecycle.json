{
    "name": "release branches - release-managers only",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["refs/heads/release-*"],
            "exclude": []
        },
        "repository_name": {
            "include": ["~ALL"],
            "exclude": []
        }
    },
    "rules": [
        { "type": "creation" },
        { "type": "deletion" }
    ],
    "bypass_actors": [
        { "actor_id": 19214021, "actor_type": "Team", "bypass_mode": "always" }
    ]
}

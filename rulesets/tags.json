{
    "name": "tags - deny all",
    "target": "tag",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["~ALL"],
            "exclude": ["refs/tags/v*"]
        },
        "repository_name": {
            "include": ["~ALL"],
            "exclude": []
        }
    },
    "rules": [
        { "type": "creation" },
        { "type": "update" },
        { "type": "deletion" },
        { "type": "non_fast_forward" }
    ],
    "bypass_actors": []
}

{
    "name": "renovate branches",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["refs/heads/renovate/**/*"],
            "exclude": []
        },
        "repository_name": {
            "include": ["~ALL"],
            "exclude": []
        }
    },
    "rules": [
        { "type": "creation" },
        { "type": "update" },
        { "type": "deletion" },
        { "type": "non_fast_forward" }
    ],
    "bypass_actors": [
        { "actor_id": 2740, "actor_type": "Integration", "bypass_mode": "always" }
    ]
}

{
    "name": "branches - release-managers only",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["~ALL"],
            "exclude": [
                "~DEFAULT_BRANCH",
                "refs/heads/gh-readonly-queue/**"
            ]
        },
        "repository_name": {
            "include": ["~ALL"],
            "exclude": []
        }
    },
    "rules": [
        { "type": "creation" },
        { "type": "update" },
        { "type": "deletion" },
        { "type": "non_fast_forward" }
    ],
    "bypass_actors": [
        { "actor_id": 19214021, "actor_type": "Team", "bypass_mode": "always" },
        { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" },
        { "actor_id": 2740, "actor_type": "Integration", "bypass_mode": "always" },
        { "actor_id": 1415820, "actor_type": "Integration", "bypass_mode": "always" }
    ]
}

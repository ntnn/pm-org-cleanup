{
    "name": "all branches - signed commits",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["~ALL"],
            "exclude": ["refs/heads/gh-readonly-queue/**"]
        },
        "repository_name": {
            "include": ["~ALL"],
            "exclude": []
        }
    },
    "rules": [{ "type": "required_signatures" }],
    "bypass_actors": [
        { "actor_id": 2740, "actor_type": "Integration", "bypass_mode": "always" },
        { "actor_id": 1415820, "actor_type": "Integration", "bypass_mode": "always" },
        { "actor_id": 262318, "actor_type": "Integration", "bypass_mode": "always" }
    ]
}

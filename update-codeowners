#!/usr/bin/env bash

log() { echo ">>> $@"; }
die() { echo "$@" >&2; exit 1; }

org=platform-mesh
branch=codeowners-cleanup

ownerless_patterns() {
    local dir=$1 file rel prefix line
    find "$dir" -name .git -prune -o -name CODEOWNERS -print | while read -r file; do
        rel=${file#$dir/}
        prefix=$(dirname "$rel")
        [[ $prefix == . || $prefix == .github || $prefix == docs ]] && prefix=""
        grep -v '^\s*\(#\|$\)' "$file" | grep -v '@' | while read -r line; do
            echo "${prefix:+$prefix/}$line"
        done
    done | sort -u
}

_set() {
    local name=$1; shift
    test $# -gt 0 || die "no owners given"
    local dir=repos/$name
    test -d "$dir" || die "no clone at $dir"
    local patterns
    patterns=$(ownerless_patterns "$dir")
    find "$dir" -name .git -prune -o -name CODEOWNERS -print -delete > /dev/null
    {
        echo "* $@"
        test -n "$patterns" && {
            echo
            echo "# ownerless so renovate can auto-merge updates"
            echo "$patterns"
        }
    } > "$dir/CODEOWNERS"
    log "$name: * $@"
}

_pr() {
    local name=$1
    local dir=repos/$name
    test -d "$dir" || die "no clone at $dir"

    local default
    default=$(git -C "$dir" symbolic-ref --short refs/remotes/upstream/HEAD | cut -d/ -f2) \
        || die "$name: cannot determine default branch"

    git -C "$dir" switch -c "$branch" 2> /dev/null || git -C "$dir" switch "$branch"
    git -C "$dir" add -A -- '*CODEOWNERS'
    git -C "$dir" diff --cached --quiet && { log "$name: no changes"; return; }
    git -C "$dir" commit -m "Restrict CODEOWNERS to maintainer teams" || die "$name: commit failed"
    git -C "$dir" push -u origin "$branch" || die "$name: push failed"
    (cd "$dir" && gh pr create \
        --repo "$org/$name" \
        --base "$default" \
        --head "$(gh api user -q .login):$branch" \
        --title "Restrict CODEOWNERS to maintainer teams" \
        --body "Part of the GitHub organisation cleanup decided in the TSC on 2026-08-19.") \
        || die "$name: PR creation failed"
}

_set_and_pr() {
    local name=$1
    shift
    _set "$name" "$@"
    # _pr "$name"
}

